{
  "components": {
    "schemas": {
      "ChangeUser": {
        "additionalProperties": false,
        "description": "Role and/or active. Neither name, login nor password is changed here.",
        "properties": {
          "active": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active"
          },
          "role": {
            "anyOf": [
              {
                "enum": [
                  "technician",
                  "clinic_admin"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Role"
          }
        },
        "title": "ChangeUser",
        "type": "object"
      },
      "CreateUser": {
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "maxLength": 128,
            "title": "Display Name",
            "type": "string"
          },
          "login": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Login",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 12,
            "title": "Password",
            "type": "string"
          },
          "role": {
            "enum": [
              "technician",
              "clinic_admin"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "display_name",
          "login",
          "role",
          "password"
        ],
        "title": "CreateUser",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "description": "DS-24 error envelope. ``error`` is a code from the error catalogue (IDR-05).",
        "properties": {
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Same value as the X-Correlation-ID response header (XC-FND-11)",
            "title": "Correlation Id"
          },
          "error": {
            "description": "Error catalogue code (error/1, IDR-05)",
            "title": "Error",
            "type": "string"
          },
          "gates": {
            "items": {
              "$ref": "#/components/schemas/Gate"
            },
            "title": "Gates",
            "type": "array"
          },
          "http_status": {
            "title": "Http Status",
            "type": "integer"
          },
          "message_ru": {
            "description": "User-facing message, Russian (NFR-05)",
            "title": "Message Ru",
            "type": "string"
          },
          "step": {
            "description": "Where the user resolves the code (FN-UIX-03): a WF-MVP-01 step S1..S12, SIGN_IN, ADMIN, or CURRENT (the current screen)",
            "enum": [
              "S1",
              "S2",
              "S3",
              "S4",
              "S5",
              "S6",
              "S7",
              "S8",
              "S9",
              "S10",
              "S11",
              "S12",
              "SIGN_IN",
              "ADMIN",
              "CURRENT"
            ],
            "title": "Step",
            "type": "string"
          }
        },
        "required": [
          "error",
          "http_status",
          "message_ru",
          "step",
          "gates",
          "correlation_id"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "Gate": {
        "additionalProperties": false,
        "description": "One failed gate or field (DS-24 ``gates[]``).",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "link": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Link"
          },
          "message_ru": {
            "description": "Russian message for code (NFR-05)",
            "title": "Message Ru",
            "type": "string"
          },
          "step": {
            "description": "Where the user resolves the code (FN-UIX-03): a WF-MVP-01 step S1..S12, SIGN_IN, ADMIN, or CURRENT (the current screen)",
            "enum": [
              "S1",
              "S2",
              "S3",
              "S4",
              "S5",
              "S6",
              "S7",
              "S8",
              "S9",
              "S10",
              "S11",
              "S12",
              "SIGN_IN",
              "ADMIN",
              "CURRENT"
            ],
            "title": "Step",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message_ru",
          "step"
        ],
        "title": "Gate",
        "type": "object"
      },
      "HealthChecks": {
        "additionalProperties": false,
        "properties": {
          "database": {
            "enum": [
              "ok",
              "fail"
            ],
            "title": "Database",
            "type": "string"
          }
        },
        "required": [
          "database"
        ],
        "title": "HealthChecks",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/HealthChecks"
          },
          "service": {
            "const": "api",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "checks"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "JobResultSummary": {
        "description": "Summary of the job-result/1 envelope: the kernel report, never the geometry itself.",
        "properties": {
          "op_type": {
            "title": "Op Type",
            "type": "string"
          },
          "op_version": {
            "title": "Op Version",
            "type": "integer"
          },
          "output_names": {
            "items": {
              "type": "string"
            },
            "title": "Output Names",
            "type": "array"
          },
          "reason_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason Code"
          },
          "report": {
            "additionalProperties": true,
            "title": "Report",
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "rejected",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "op_type",
          "op_version",
          "status",
          "reason_code",
          "output_names",
          "report"
        ],
        "title": "JobResultSummary",
        "type": "object"
      },
      "JobStatusResponse": {
        "additionalProperties": false,
        "description": "FN-JOB-03: what the UI polls while a job runs.",
        "properties": {
          "attempts": {
            "title": "Attempts",
            "type": "integer"
          },
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlation Id"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Error catalogue code when status is failed",
            "title": "Error Code"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "job_id": {
            "format": "uuid",
            "title": "Job Id",
            "type": "string"
          },
          "message_ru": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Russian message for error_code (NFR-05)",
            "title": "Message Ru"
          },
          "progress": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "0..1 when the job reports progress; null otherwise",
            "title": "Progress"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobResultSummary"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "step": {
            "anyOf": [
              {
                "enum": [
                  "S1",
                  "S2",
                  "S3",
                  "S4",
                  "S5",
                  "S6",
                  "S7",
                  "S8",
                  "S9",
                  "S10",
                  "S11",
                  "S12",
                  "SIGN_IN",
                  "ADMIN",
                  "CURRENT"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Where the user resolves error_code, or the rejected op's reason_code (FN-UIX-03); null when neither is set",
            "title": "Step"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "type",
          "status",
          "attempts",
          "progress",
          "result",
          "error_code",
          "message_ru",
          "step",
          "correlation_id",
          "created_at",
          "finished_at"
        ],
        "title": "JobStatusResponse",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "properties": {
          "login": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Login",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "login",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "LoginResponse": {
        "description": "The session token travels only in the httpOnly cookie; the CSRF token in this body.",
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/SessionUser"
          }
        },
        "required": [
          "csrf_token",
          "user"
        ],
        "title": "LoginResponse",
        "type": "object"
      },
      "SessionUser": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "role": {
            "enum": [
              "technician",
              "clinic_admin"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "display_name",
          "role"
        ],
        "title": "SessionUser",
        "type": "object"
      },
      "User": {
        "additionalProperties": false,
        "description": "FN-IAM-05 output: the account without any credential.",
        "properties": {
          "active": {
            "title": "Active",
            "type": "boolean"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "login": {
            "title": "Login",
            "type": "string"
          },
          "role": {
            "enum": [
              "technician",
              "clinic_admin"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "display_name",
          "login",
          "role",
          "active",
          "created_at"
        ],
        "title": "User",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Jude API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "BAD_CREDENTIALS"
          },
          "423": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "ACCOUNT_LOCKED (gate detail: unlock time UTC)"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error (DS-24)"
          }
        },
        "summary": "Login"
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "FN-IAM-03: delete the session, emit auth.logout, expire the cookie. Idempotent (204).",
        "operationId": "logout_route",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "CSRF_INVALID (live session)"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error (DS-24)"
          }
        },
        "summary": "Logout Route"
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Database unreachable"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error (DS-24)"
          }
        },
        "summary": "Health"
      }
    },
    "/api/v1/jobs/{job_id}": {
      "get": {
        "operationId": "get_job",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unknown job, or not visible"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error (DS-24)"
          }
        },
        "summary": "Get Job"
      }
    },
    "/api/v1/users": {
      "get": {
        "operationId": "list_users",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/User"
                  },
                  "title": "Response List Users",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error (DS-24)"
          }
        },
        "summary": "List Users"
      },
      "post": {
        "operationId": "create_user",
        "parameters": [
          {
            "description": "Required (428 IDEMPOTENCY_KEY_REQUIRED, checked after the session). UUID v4 chosen by the client per operation; send it again to retry (FN-API-01).",
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Required (428 IDEMPOTENCY_KEY_REQUIRED, checked after the session). UUID v4 chosen by the client per operation; send it again to retry (FN-API-01).",
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUser"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "LOGIN_TAKEN"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "NAME_REQUIRED, IDEMPOTENCY_KEY_REUSED, REQUEST_INVALID"
          },
          "428": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "IDEMPOTENCY_KEY_REQUIRED"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error (DS-24)"
          }
        },
        "summary": "Create User"
      }
    },
    "/api/v1/users/{user_id}": {
      "patch": {
        "operationId": "change_user",
        "parameters": [
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "User Id",
              "type": "string"
            }
          },
          {
            "description": "Required (428 IDEMPOTENCY_KEY_REQUIRED, checked after the session). UUID v4 chosen by the client per operation; send it again to retry (FN-API-01).",
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Required (428 IDEMPOTENCY_KEY_REQUIRED, checked after the session). UUID v4 chosen by the client per operation; send it again to retry (FN-API-01).",
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeUser"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unknown account"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "LAST_ADMIN"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "IDEMPOTENCY_KEY_REUSED, REQUEST_INVALID"
          },
          "428": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "IDEMPOTENCY_KEY_REQUIRED"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error (DS-24)"
          }
        },
        "summary": "Change User"
      }
    }
  }
}
