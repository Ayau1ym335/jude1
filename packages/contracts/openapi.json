{
  "components": {
    "schemas": {
      "ErrorResponse": {
        "additionalProperties": false,
        "description": "DS-24 error envelope. ``error`` is a code from the error catalogue (IDR-05).",
        "properties": {
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Same value as the X-Correlation-ID response header (XC-FND-11)",
            "title": "Correlation Id"
          },
          "error": {
            "description": "Error catalogue code (error/1, IDR-05)",
            "title": "Error",
            "type": "string"
          },
          "gates": {
            "items": {
              "$ref": "#/components/schemas/Gate"
            },
            "title": "Gates",
            "type": "array"
          },
          "http_status": {
            "title": "Http Status",
            "type": "integer"
          },
          "message_ru": {
            "description": "User-facing message, Russian (NFR-05)",
            "title": "Message Ru",
            "type": "string"
          }
        },
        "required": [
          "error",
          "http_status",
          "message_ru",
          "gates",
          "correlation_id"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "Gate": {
        "additionalProperties": false,
        "description": "One failed gate or field (DS-24 ``gates[]``).",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "link": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Link"
          }
        },
        "required": [
          "code"
        ],
        "title": "Gate",
        "type": "object"
      },
      "HealthChecks": {
        "additionalProperties": false,
        "properties": {
          "database": {
            "enum": [
              "ok",
              "fail"
            ],
            "title": "Database",
            "type": "string"
          }
        },
        "required": [
          "database"
        ],
        "title": "HealthChecks",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/HealthChecks"
          },
          "status": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "HealthResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Jude API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Database unreachable"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error (DS-24)"
          }
        },
        "summary": "Health"
      }
    }
  }
}
