{
  "components": {
    "schemas": {
      "ErrorResponse": {
        "additionalProperties": false,
        "description": "DS-24 error envelope. ``error`` is a code from the error catalogue (IDR-05).",
        "properties": {
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Same value as the X-Correlation-ID response header (XC-FND-11)",
            "title": "Correlation Id"
          },
          "error": {
            "description": "Error catalogue code (error/1, IDR-05)",
            "title": "Error",
            "type": "string"
          },
          "gates": {
            "items": {
              "$ref": "#/components/schemas/Gate"
            },
            "title": "Gates",
            "type": "array"
          },
          "http_status": {
            "title": "Http Status",
            "type": "integer"
          },
          "message_ru": {
            "description": "User-facing message, Russian (NFR-05)",
            "title": "Message Ru",
            "type": "string"
          }
        },
        "required": [
          "error",
          "http_status",
          "message_ru",
          "gates",
          "correlation_id"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "Gate": {
        "additionalProperties": false,
        "description": "One failed gate or field (DS-24 ``gates[]``).",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "link": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Link"
          }
        },
        "required": [
          "code"
        ],
        "title": "Gate",
        "type": "object"
      },
      "HealthChecks": {
        "additionalProperties": false,
        "properties": {
          "database": {
            "enum": [
              "ok",
              "fail"
            ],
            "title": "Database",
            "type": "string"
          }
        },
        "required": [
          "database"
        ],
        "title": "HealthChecks",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/HealthChecks"
          },
          "service": {
            "const": "api",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "checks"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "JobResultSummary": {
        "description": "Summary of the job-result/1 envelope: the kernel report, never the geometry itself.",
        "properties": {
          "op_type": {
            "title": "Op Type",
            "type": "string"
          },
          "op_version": {
            "title": "Op Version",
            "type": "integer"
          },
          "output_names": {
            "items": {
              "type": "string"
            },
            "title": "Output Names",
            "type": "array"
          },
          "reason_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason Code"
          },
          "report": {
            "additionalProperties": true,
            "title": "Report",
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "rejected",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "op_type",
          "op_version",
          "status",
          "reason_code",
          "output_names",
          "report"
        ],
        "title": "JobResultSummary",
        "type": "object"
      },
      "JobStatusResponse": {
        "additionalProperties": false,
        "description": "FN-JOB-03: what the UI polls while a job runs.",
        "properties": {
          "attempts": {
            "title": "Attempts",
            "type": "integer"
          },
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlation Id"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Error catalogue code when status is failed",
            "title": "Error Code"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "job_id": {
            "format": "uuid",
            "title": "Job Id",
            "type": "string"
          },
          "message_ru": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Russian message for error_code (NFR-05)",
            "title": "Message Ru"
          },
          "progress": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "0..1 when the job reports progress; null otherwise",
            "title": "Progress"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobResultSummary"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "type",
          "status",
          "attempts",
          "progress",
          "result",
          "error_code",
          "message_ru",
          "correlation_id",
          "created_at",
          "finished_at"
        ],
        "title": "JobStatusResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Jude API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Database unreachable"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error (DS-24)"
          }
        },
        "summary": "Health"
      }
    },
    "/api/v1/jobs/{job_id}": {
      "get": {
        "operationId": "get_job",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unknown job, or not visible"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error (DS-24)"
          }
        },
        "summary": "Get Job"
      }
    }
  }
}
